# Credenciales solo en este archivo del servidor. Reiniciar después de editar.
MODEL_API_KEY=
# Solo se habilitan llamadas con costo cuando cambies esto a true expresamente.
ENABLE_PAID_APIS=false
META_SPARK_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
HF_API_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_LOGIN_TYPE=facebook
IG_GRAPH_VERSION=v25.0
# Meta Marketing API: token con ads_management y acceso a la cuenta publicitaria.
# Son credenciales separadas del token de Instagram Content Publishing.
ADS_ACCESS_TOKEN=
ADS_ACCOUNT_ID=
ADS_PAGE_ID=
ADS_IG_ACTOR_ID=
ADS_GRAPH_VERSION=v25.0
# HTTPS público para que Instagram descargue los archivos. Sin barra final.
PUBLIC_BASE_URL=
# Opcional: controles de acceso al servidor local / túnel.
APP_ACCESS_CODE=
PORT=8844
HOST=0.0.0.0

# Crear objetos PAUSED en Meta inicia revisión; mantener false para borrador solo local.
ENABLE_META_ADS_WRITE=false

# Kling oficial, video Omni 4.0 en vertical 720p. Nunca pegar la clave en el cliente.
KLING_API_KEY=
# Video con Kling 4.0 vía fal.ai (el saldo de fal no vence). Si hay FAL_KEY se usa fal, salvo VIDEO_PROVIDER=kling.
FAL_KEY=
VIDEO_PROVIDER=
# Tope de videos de pago por 24 h (máximo 10; aquí solo se puede bajar)
VIDEO_MAX_PER_DAY=

# Directorio activo; los datos originales se conservan en data/.
DATA_DIR=data-current
